DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_password_here
DB_NAME=conference_db

# ต้องส่งมาใน header X-Admin-Key เพื่อเรียก endpoint ที่ทำลายข้อมูลถาวร (ลบทั้งหมด, ลบถาวร)
# ตั้งเป็นค่าสุ่มที่คาดเดายาก แล้วตั้งค่าเดียวกันใน Frontend/.env เป็น VITE_ADMIN_KEY
ADMIN_API_KEY=change_me_to_a_long_random_secret

# โดเมนของ Frontend ที่อนุญาตให้เรียก API (คั่นด้วย comma ถ้ามีหลายโดเมน)
# ตอน deploy จริงให้ใส่โดเมนจริงของหน้าเว็บ เช่น https://conference.example.go.th
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Channel secret จาก LINE Developers Console — ใช้ตรวจสอบ X-Line-Signature ของ webhook
# ถ้าไม่ตั้งไว้ /line/webhook จะปฏิเสธทุก request
LINE_CHANNEL_SECRET=your_line_channel_secret_here
